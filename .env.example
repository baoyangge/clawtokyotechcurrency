# Copy to .env and fill values

# Admin bootstrap (used by your app logic if applicable)
ADMIN_EMAIL=""

# iron-session: must be >= 32 chars (use a strong random string)
SESSION_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"

# SQLite persisted inside container (mounted volume)
DATABASE_URL="file:/app/data/dev.db"
